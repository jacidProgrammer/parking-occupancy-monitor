# Published Custom Vision model: customvision.ai → Performance → Prediction URL.
# The URL is the one under "If you have an image file" (it ends in /image).
AZURE_CUSTOM_VISION_PREDICTION_URL=https://<resource>.cognitiveservices.azure.com/customvision/v3.0/Prediction/<project-id>/detect/iterations/<published-name>/image
AZURE_CUSTOM_VISION_PREDICTION_KEY=

# Only for scripts/import-dataset.mjs (uploads a labelled dataset to Custom Vision)
AZURE_CUSTOM_VISION_TRAINING_ENDPOINT=https://<resource>.cognitiveservices.azure.com
AZURE_CUSTOM_VISION_TRAINING_KEY=
AZURE_CUSTOM_VISION_PROJECT_ID=
